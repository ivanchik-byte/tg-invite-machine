# ============================================================
# TG-Invite-Machine Configuration
# ============================================================

# Telegram Bot Token from @BotFather (Management Interface)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID of Administrator (only this ID has access to bot UI)
ADMIN_ID=123456789

# Telegram API credentials for MTProto userbots (from my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Symmetric Fernet key for session storage encryption
# Generate via: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Database URL (SQLite default, or postgresql+asyncpg://user:pass@localhost:5432/inviter_db)
DATABASE_URL=sqlite+aiosqlite:///./data/inviter.db

# Operational Speed Profile: cautious | normal | fast
DEFAULT_SPEED_PROFILE=normal

# Anti-Flood & Behavioral Emulation Parameters
MIN_DELAY_BETWEEN_INVITES=35
MAX_DELAY_BETWEEN_INVITES=75
MAX_INVITES_PER_SESSION_DAILY=20
CIRCUIT_BREAKER_FLOOD_THRESHOLD=3
